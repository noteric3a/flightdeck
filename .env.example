# Run python scripts/setup_env.py to generate the two tokens.
ADMIN_TOKEN=
DEVICE_TOKEN=
FLIGHT_PROVIDER=demo
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Optional FlightAware account for live route, aircraft, and arrival estimates.
# Lookups are billable under your AeroAPI plan. No key = no details requests.
AEROAPI_KEY=
DETAILS_CACHE_TTL_SECONDS=300
AEROAPI_MAX_REQUESTS_PER_HOUR=120
# Optional. Default: 30 seconds authenticated/demo; 240 seconds anonymous.
# CACHE_TTL_SECONDS=30
STALE_SECONDS=180
DATABASE_PATH=data/flightdeck.db
# Comma-separated exact HTTPS editor origins; unnecessary for the same-origin editor.
CORS_ORIGINS=
PORT=8000
